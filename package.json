{
  "name": "@tradejs/strategy-ridge-m15",
  "version": "0.1.1",
  "description": "TradeJS portfolio strategy with Ridge ranking across six signal sources and 15-minute confirmation for additional TradingPatterns entries.",
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": "24.x"
  },
  "homepage": "https://tradejs.dev",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "devDependencies": {
    "@tradejs/core": "3.1.29",
    "@tradejs/strategy-diamond": "0.1.2",
    "@tradejs/strategy-double-tap": "3.0.6",
    "@tradejs/strategy-flag": "0.1.7",
    "@tradejs/strategy-gartley": "0.1.3",
    "@tradejs/strategy-head-and-shoulders": "3.0.8",
    "@tradejs/strategy-kit": "3.0.6",
    "@tradejs/strategy-liquidity-tails": "3.0.7",
    "@tradejs/strategy-trading-patterns": "0.1.3",
    "@tradejs/strategy-trend-follow": "3.0.7",
    "@tradejs/strategy-trend-shift": "3.0.6",
    "@tradejs/types": "3.1.29",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.2.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "build": "tsup",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "checks": "yarn format:check && yarn typecheck && yarn test && yarn build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "BUSL-1.1",
  "author": "aleksnick (https://github.com/aleksnick)",
  "peerDependencies": {
    "@tradejs/core": "3.1.29",
    "@tradejs/strategy-diamond": "0.1.2",
    "@tradejs/strategy-double-tap": "3.0.6",
    "@tradejs/strategy-flag": "0.1.7",
    "@tradejs/strategy-gartley": "0.1.3",
    "@tradejs/strategy-head-and-shoulders": "3.0.8",
    "@tradejs/strategy-kit": "3.0.6",
    "@tradejs/strategy-liquidity-tails": "3.0.7",
    "@tradejs/strategy-trading-patterns": "0.1.3",
    "@tradejs/strategy-trend-follow": "3.0.7",
    "@tradejs/strategy-trend-shift": "3.0.6",
    "@tradejs/types": "3.1.29"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TradeJS-Dev/TradeJS-Strategy-RidgeM15.git"
  }
}
